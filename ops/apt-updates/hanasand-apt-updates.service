[Unit]
Description=Hanasand staged Ubuntu update monitor
After=network-online.target apt-daily.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hanasand-apt-update
User=root
# APT needs to drop to its _apt sandbox user; NoNewPrivileges would block it.
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/hanasand/apt-updates /var/log
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
