[Unit]
Description=Hanasand staged Ubuntu update monitor
After=network-online.target apt-daily.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hanasand-apt-update
User=root
# APT needs to drop to its _apt sandbox user; NoNewPrivileges would block it.
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# APT/dpkg must replace files in the system package roots while the rest of the
# service remains sandboxed.
ReadWritePaths=/var/lib/hanasand/apt-updates /var/log /etc /usr /lib /boot
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
