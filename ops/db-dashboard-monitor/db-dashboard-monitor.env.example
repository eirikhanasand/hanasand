HANASAND_DB_MONITOR_BASE_URL=https://hanasand.com
# Loaded by the runner from /home/hanasand/monitor-state/service-accounts.env.
HANASAND_DB_MONITOR_SERVICE_ACCOUNT_KEY=
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace_me
HANASAND_DB_MONITOR_DISCORD_MENTION=@here
HANASAND_DB_MONITOR_REPEAT_ALERT_MINUTES=15
HANASAND_DB_MONITOR_FAILURE_THRESHOLD=2
HANASAND_DB_MONITOR_TIMEOUT_MS=30000
HANASAND_DB_MONITOR_CDN_BASE_URL=https://cdn.hanasand.com/api
HANASAND_DB_MONITOR_CDN_FOLDER=monitor/db-dashboard
# Optional: set these if CDN uploads should be owned by the monitor user.
HANASAND_DB_MONITOR_CDN_USER=
HANASAND_DB_MONITOR_CDN_TOKEN=
HANASAND_STATUS_INGEST_BASE_URL=https://api.hanasand.com
HANASAND_STATUS_INGEST_TOKEN=replace_with_vm_api_token
HANASAND_TI_BACKUP_STATUS=/home/hanasand/backups/threat-intel/LATEST-STATUS
HANASAND_TI_BACKUP_MONITOR_STATE=/home/hanasand/monitor-state/threat-intel-backup.json
HANASAND_TI_BACKUP_MAX_AGE_HOURS=30
