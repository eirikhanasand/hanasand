[Unit]
Description=Reclaim empty PostgreSQL log table tails above 20 GB
After=docker.service

[Service]
Type=oneshot
User=hanasand
Group=hanasand
SupplementaryGroups=docker
ExecStart=/usr/local/bin/bun /home/hanasand/hanasand/scripts/recovery/database-shrink.ts
TimeoutStartSec=150
Nice=15
IOSchedulingClass=idle
